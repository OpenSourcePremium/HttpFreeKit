<UserControl x:Class="HttpFreeKit.Views.JsonTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource BgBrush}">
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
            ClipToBounds="True">
        <avalon:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13"
                           Background="Transparent" BorderThickness="0" Padding="8"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           ShowLineNumbers="True" WordWrap="False"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </Border>
</UserControl>
