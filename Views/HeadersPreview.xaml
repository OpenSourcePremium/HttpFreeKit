<UserControl x:Class="HttpFreeKit.Views.HeadersPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="StartLineBorder" Margin="8,6,8,2" Padding="8,5"
                Background="{DynamicResource Surface2Brush}" CornerRadius="5"
                Visibility="Collapsed">
            <TextBox x:Name="StartLineText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     FontFamily="Consolas" FontSize="11"
                     Foreground="{DynamicResource AppForegroundSecondaryBrush}"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled"
                     HorizontalScrollBarVisibility="Disabled"/>
        </Border>
        <Border x:Name="ColumnHeader" Grid.Row="1" Padding="8,6"
                Background="{DynamicResource Surface2Brush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderNameText" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="HeaderValueText" Grid.Column="1" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
        </Border>
        <ScrollViewer x:Name="HeadersScrollViewer" Grid.Row="2" Margin="0,0,0,4"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding HeaderLines, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         MinHeight="0" VerticalContentAlignment="Top"
                                         FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AppForegroundSecondaryBrush}"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True" BorderThickness="0"
                                         Background="Transparent" Padding="0" MinHeight="0"
                                         VerticalContentAlignment="Top" FontFamily="Consolas"
                                         FontSize="11" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid x:Name="StatusOverlay" Grid.Row="2" Background="{DynamicResource BgBrush}"
              Opacity="0.94" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="150">
                <Grid Height="3" ClipToBounds="True">
                    <Border x:Name="LoadingIndicator" Width="45" HorizontalAlignment="Left"
                            Background="{DynamicResource SelectionBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LoadingIndicatorTransform"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="LoadingText" Margin="0,10,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
