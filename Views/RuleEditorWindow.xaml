<Window x:Class="HttpFreeKit.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:HttpFreeKit.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Règle" Width="760" Height="780" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Border Background="Transparent" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="IDENTITÉ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                        <TextBox ui:ControlHelper.Header="Nom" ui:ControlHelper.PlaceholderText="Ex. : Bloquer les publicités"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Règle active" IsChecked="{Binding Enabled}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="Transparent" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Conditions (toutes doivent correspondre)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PhaseCombo" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                  ui:ControlHelper.Header="S'applique à la phase"
                                  ItemsSource="{Binding PhaseOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding Phase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="PhaseCombo_SelectionChanged"/>
                        <ItemsControl x:Name="MatcherList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding FieldOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Field}"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding OpOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Op}"/>
                                        <TextBox Grid.Column="2" ui:ControlHelper.PlaceholderText="Ex. : *.example.com"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Grid.Column="3" Content="NON" IsChecked="{Binding Negate}" Margin="10,0,0,0" MinWidth="0"/>
                                        <Button Grid.Column="4" Content="✕" Margin="8,0,0,0" Click="RemoveMatcher_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Ajouter une condition" Click="AddMatcher_Click" Margin="0,4,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Background="Transparent" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0" Padding="0">
                    <StackPanel>
                        <TextBlock Text="Action" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ActionCombo" HorizontalAlignment="Stretch"
                                  ui:ControlHelper.Header="Action"
                                  ItemsSource="{Binding ActionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ActionType}"
                                  SelectionChanged="ActionCombo_SelectionChanged"/>

                        <StackPanel x:Name="PnlStatus" Margin="0,8,0,0">
                            <TextBox ui:ControlHelper.Header="Code HTTP" ui:ControlHelper.PlaceholderText="Ex. : 403"
                                     Text="{Binding StatusCode, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel x:Name="PnlMockOnly">
                                <TextBox x:Name="ContentTypeBox" Margin="0,10,0,0" ui:ControlHelper.Header="Content-Type"
                                         ui:ControlHelper.PlaceholderText="Ex. : application/json"
                                         TextChanged="ContentTypeBox_TextChanged"
                                         Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="0,10,0,0" ui:ControlHelper.Header="Corps depuis un fichier (optionnel, prioritaire)"
                                         ui:ControlHelper.PlaceholderText="Ex. : C:\reponses\mock.json"
                                         Text="{Binding BodyFile, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Corps / message affiché" Margin="0,0,0,5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <views:JsonTextEditor x:Name="BodyJsonEditor" MinHeight="120"
                                                      Text="{Binding Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PnlUrl" Margin="0,8,0,0">
                            <TextBox ui:ControlHelper.Header="URL complète de destination (https://…)"
                                     ui:ControlHelper.PlaceholderText="Ex. : https://api.example.com/v2"
                                     Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel x:Name="PnlHeader" Margin="0,8,0,0">
                            <TextBox ui:ControlHelper.Header="Nom de l'en-tête" ui:ControlHelper.PlaceholderText="Ex. : X-Debug-Mode"
                                     Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox x:Name="HeaderValueBox" Margin="0,10,0,0" ui:ControlHelper.Header="Valeur"
                                     ui:ControlHelper.PlaceholderText="Ex. : true"
                                     Text="{Binding HeaderValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel x:Name="PnlReplace" Margin="0,8,0,0">
                            <TextBox ui:ControlHelper.Header="Texte à chercher" ui:ControlHelper.PlaceholderText="Ex. : production"
                                     Text="{Binding FindPattern, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Expression régulière" IsChecked="{Binding FindIsRegex}" Margin="0,8,0,0"/>
                            <TextBox Margin="0,10,0,0" ui:ControlHelper.Header="Remplacer par"
                                     ui:ControlHelper.PlaceholderText="Ex. : staging"
                                     Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel x:Name="PnlDelay" Margin="0,8,0,0">
                            <TextBox ui:ControlHelper.Header="Délai (millisecondes)" ui:ControlHelper.PlaceholderText="Ex. : 500"
                                     Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock x:Name="HintText" Margin="0,10,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Annuler" IsCancel="True" Margin="0,0,10,0" MinWidth="100"/>
            <Button Content="Enregistrer" IsDefault="True" Click="Ok_Click" MinWidth="120"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
