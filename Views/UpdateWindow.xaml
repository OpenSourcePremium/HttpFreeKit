<Window x:Class="HttpFreeKit.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="HTTP FreeKit"
        Width="720" Height="600" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowShell" CornerRadius="12" BorderThickness="1"
            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="11,11,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="20" Height="20" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource HttpFreeKitAccentLightColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource HttpFreeKitAccentColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M5,9 H17 M14,6 L17,9 L14,12 M19,15 H7 M10,12 L7,15 L10,18"
                                  Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <TextBlock Text="HTTP FreeKit" FontWeight="SemiBold" FontSize="13"
                                   Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForegroundBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" Tag="close"
                            Margin="0,0,8,0" Click="Close_Click" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Fill"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,24,28,16">
                <TextBlock x:Name="WindowHeading" Text="New version available" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="ReleaseTitleText" FontSize="25" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource AppForegroundBrush}"/>
                <TextBlock x:Name="VersionText" FontSize="12" Margin="0,7,0,0"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="28,0,28,8" Padding="16"
                    CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Release notes" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForegroundBrush}"/>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReleaseNotesText" FontSize="13" LineHeight="20"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource AppForegroundSecondaryBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="28,0,28,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource MutedBrush}"/>
                <CheckBox x:Name="DoNotRemindCheckBox" Grid.Row="1"
                          Content="Don't remind me about this version"
                          Margin="0,0,0,8" VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ProgressBar x:Name="DownloadProgressBar" Width="110" Height="6"
                                     Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="IgnoreButton" Content="Ignore this version" Click="Ignore_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="InstallButton" Content="Install update" Click="Install_Click"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderBrush="{DynamicResource AccentBrush}"/>
                        <Button x:Name="CancelButton" Content="Cancel update" Click="CancelInstall_Click"
                                Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="DismissButton" Content="Close" Click="Close_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
