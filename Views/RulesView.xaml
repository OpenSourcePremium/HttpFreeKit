<UserControl x:Class="HttpFreeKit.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <UserControl.Resources>
        <ContextMenu x:Key="RuleContextMenu" x:Shared="False">
            <MenuItem Header="Modifier" Click="Edit_Click"/>
            <MenuItem Header="Dupliquer" Click="Dup_Click"/>
            <Separator/>
            <MenuItem Header="Supprimer" Click="Del_Click"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Nouvelle…" Click="Add_Click" Margin="0,0,20,0"
                    Style="{DynamicResource AccentButtonStyle}"/>
            <Button Content="Importer…" Click="Import_Click" Margin="0,0,8,0"/>
            <Button Content="Exporter…" Click="Export_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="8" Padding="0" ClipToBounds="True">
        <Grid>
        <DataGrid x:Name="RulesGrid" Style="{StaticResource FlatGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" MouseDoubleClick="Edit_Click" AllowDrop="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource FlatRow}">
                    <Setter Property="Cursor" Value="SizeAll"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value><StaticResource ResourceKey="RuleContextMenu"/></Setter.Value>
                    </Setter>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="RuleRow_RightClick"/>
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RuleRow_MouseLeftButtonDown"/>
                    <EventSetter Event="PreviewMouseMove" Handler="RuleRow_MouseMove"/>
                    <EventSetter Event="DragOver" Handler="RuleRow_DragOver"/>
                    <EventSetter Event="Drop" Handler="RuleRow_Drop"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Actif" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Click="Enabled_Click"
                                      HorizontalAlignment="Center" MinWidth="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="230"/>
                <DataGridTextColumn Header="Phase" Binding="{Binding PhaseLabel}" Width="170"/>
                <DataGridTextColumn Header="Conditions" Binding="{Binding ConditionSummary}" Width="*"/>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionSummary}" Width="260"/>
                <DataGridTextColumn Header="Déclenchée" Binding="{Binding Hits}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No rules configured" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Opacity="0.65" TextWrapping="Wrap"
                   Text="Les règles sont évaluées de haut en bas. Les actions « Bloquer », « Répondre automatiquement » et « Rediriger » s'arrêtent à la première qui correspond ; les modifications d'en-têtes, de corps et les retards s'enchaînent."/>
    </Grid>
</UserControl>
