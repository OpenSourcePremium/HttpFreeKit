<UserControl x:Class="HttpFreeKit.Views.TrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:views="clr-namespace:HttpFreeKit.Views">
    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="120"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="2*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Text="0 requête" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox x:Name="FollowCheck" Content="Suivre" IsChecked="True" Margin="0,0,12,0" MinWidth="0"/>
                <CheckBox x:Name="PauseCheck" Content="Pause" Margin="0,0,12,0" MinWidth="0"
                          Checked="Pause_Changed" Unchecked="Pause_Changed"/>
                <Button Content="Importer HAR…" Click="ImportHar_Click" Margin="0,0,6,0"/>
                <Button Content="Exporter HAR…" Click="ExportHar_Click" Margin="0,0,6,0"/>
                <Button Content="Effacer" Click="Clear_Click"/>
            </StackPanel>
            <TextBox x:Name="FilterBox" Margin="0,0,16,0"
                     ui:ControlHelper.PlaceholderText="Ex. statuscode:200 host:example.com path:/login"
                     ToolTip="Filtres : statuscode, host, path, process, pid, method, rule, outcome, scheme, url. Combinez les critères ; les valeurs avec espaces peuvent être entre guillemets."
                     TextChanged="FilterBox_TextChanged"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="8" Padding="0" ClipToBounds="True">
        <Grid>
        <DataGrid x:Name="TrafficGrid" Style="{StaticResource FlatGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" FontSize="12" EnableRowVirtualization="True"
                  SelectionChanged="TrafficGrid_SelectionChanged">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="TrafficContextMenu_Opened">
                    <MenuItem Header="Copier l'URL" Click="Ctx_CopyUrl"/>
                    <MenuItem Header="Copy as…">
                        <MenuItem Header="cURL" Tag="Curl" Click="Ctx_CopyAs"/>
                        <MenuItem Header="Batch (Windows)" Tag="Batch" Click="Ctx_CopyAs"/>
                        <Separator/>
                        <MenuItem Header="Node.js (fetch)" Tag="NodeJs" Click="Ctx_CopyAs"/>
                        <MenuItem Header="Python (requests)" Tag="Python" Click="Ctx_CopyAs"/>
                        <MenuItem Header="Lua (LuaSocket)" Tag="Lua" Click="Ctx_CopyAs"/>
                        <MenuItem Header="Go (net/http)" Tag="Go" Click="Ctx_CopyAs"/>
                        <MenuItem Header="C# (HttpClient)" Tag="CSharp" Click="Ctx_CopyAs"/>
                        <MenuItem Header="C++ (libcurl)" Tag="Cpp" Click="Ctx_CopyAs"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Ouvrir dans Tests réseau" Click="Ctx_OpenNetTest"/>
                    <MenuItem Header="Rejouer maintenant" Click="Ctx_ReplayNetTest"/>
                    <Separator/>
                    <MenuItem Header="Règle : bloquer cet hôte…" Click="Ctx_BlockHost"/>
                    <MenuItem Header="Règle : réponse automatique depuis cette réponse…" Click="Ctx_Mock"/>
                    <MenuItem Header="Ne pas déchiffrer cet hôte (HTTPS)" Click="Ctx_NoDecrypt"/>
                    <Separator/>
                    <MenuItem Header="Bloquer cette application (pare-feu)…" Click="Ctx_BlockApp"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="55"/>
                <DataGridTextColumn Header="Heure" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="75"/>
                <DataGridTextColumn Header="Application" Binding="{Binding Process}" Width="130"/>
                <DataGridTemplateColumn Header="Méthode" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Method}" Foreground="{Binding MethodBrush}"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Hôte" Binding="{Binding Host}" Width="190"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="*" MinWidth="180"/>
                <DataGridTemplateColumn Header="Statut" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding OutcomeText}" Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBreakpointPending}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="{Binding BreakpointEditText}" Click="BreakpointEdit_Click"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Padding="6,0" MouseEnter="BreakpointEdit_MouseEnter"
                                        MouseLeave="BreakpointEdit_MouseLeave">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ButtonBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="1"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"
                                                                              RecognizesAccessKey="True"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonBorder" Property="Background"
                                                                        Value="{DynamicResource TitleBarHoverBorderBrush}"/>
                                                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                                                        Value="{DynamicResource AppForegroundSecondaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ButtonBorder" Property="Background"
                                                                        Value="{DynamicResource SelectionBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBreakpointPending}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="75"/>
                <DataGridTextColumn Header="Durée" Binding="{Binding DurationText}" Width="75"/>
                <DataGridTextColumn Header="Règle" Binding="{Binding RuleName}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No requests yet" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="Transparent"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" CornerRadius="8" Padding="10,6,10,10">
        <TabControl Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DetailTabItem}">
            <TabItem Header="Requête">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource BgBrush}"
                            CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <views:HeadersPreview x:Name="RequestHeadersPreview"
                                Language="{Binding Language, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>
                    </Border>
                    <views:BodyPreview Grid.Column="1" x:Name="RequestBodyPreview"
                                       Language="{Binding Language, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Réponse">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource BgBrush}"
                            CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <views:HeadersPreview x:Name="ResponseHeadersPreview"
                                Language="{Binding Language, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>
                    </Border>
                    <views:BodyPreview Grid.Column="1" x:Name="ResponseBodyPreview"
                                       Language="{Binding Language, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </TabItem>
        </TabControl>
        </Border>
    </Grid>
</UserControl>
