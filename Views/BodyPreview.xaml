<UserControl x:Class="HttpFreeKit.Views.BodyPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="BinaryBanner" Grid.Row="0" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0" Padding="8,5">
            <TextBlock x:Name="BinaryLabel" FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource AppForegroundSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource BgBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DockPanel>
                    <TextBlock x:Name="BodyTitle" DockPanel.Dock="Top" Text="Body" Margin="8,6,0,0"
                               FontSize="11" Foreground="{DynamicResource AppForegroundSecondaryBrush}"/>
                    <RichTextBox x:Name="PreviewBox" IsReadOnly="True" IsDocumentEnabled="False"
                                 BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AppForegroundBrush}"
                                 FontFamily="Consolas" FontSize="12" Padding="8"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 IsTabStop="False" SelectionBrush="{DynamicResource SelectionBrush}"
                                 SelectionOpacity="0.6"/>
                </DockPanel>
                <Border x:Name="LoadingOverlay" Background="{DynamicResource BgBrush}" Opacity="0.94"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="150">
                        <Grid Height="3" ClipToBounds="True">
                            <Border x:Name="LoadingIndicator" Width="45" HorizontalAlignment="Left"
                                    Background="{DynamicResource SelectionBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="LoadingIndicatorTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="LoadingText" Margin="0,10,0,0" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
