<UserControl x:Class="HttpFreeKit.Views.NetTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:views="clr-namespace:HttpFreeKit.Views"
             PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <ContextMenu x:Key="RequestTabContextMenu" Opened="RequestTabContextMenu_Opened"/>
        <Style x:Key="RequestTabItem" TargetType="TabItem"
               BasedOn="{StaticResource DetailTabItem}">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="ContextMenu" Value="{StaticResource RequestTabContextMenu}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RequestTab_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="RequestTab_PreviewMouseMove"/>
            <EventSetter Event="DragOver" Handler="RequestTab_DragOver"/>
            <EventSetter Event="Drop" Handler="RequestTab_Drop"/>
        </Style>
        <Style x:Key="RequestEditorSectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background"
                                        Value="{DynamicResource Surface2Brush}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush"
                                        Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background"
                                        Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush"
                                        Value="{DynamicResource LineBrush}"/>
                                <Setter Property="Margin" Value="0,0,0,-1"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequestEditorSectionTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RequestEditorSectionTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequestTabAddButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="12,0,12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background"
                                        Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background"
                                        Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequestTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="16,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background"
                                        Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequestTabsScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Height="7" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Focusable="False"
                                                  Opacity="0" Command="ScrollBar.PageLeftCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinWidth="24" IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource LineBrush}"
                                                        CornerRadius="3" Margin="0,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Focusable="False"
                                                  Opacity="0" Command="ScrollBar.PageRightCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="RequestTabsWithAddTemplate" TargetType="TabControl">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="7"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="RequestTabScrollViewer"
                                  Grid.Row="0"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  ScrollChanged="RequestTabScrollViewer_ScrollChanged"
                                  Loaded="RequestTabScrollViewer_Loaded">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Button Content="+" Style="{StaticResource RequestTabAddButton}"
                                    Click="New_Click"
                                    ToolTip="Créer un nouvel onglet de requête"
                                    AutomationProperties.Name="Nouvelle requête"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="LeftTabFade" Grid.Row="0" Width="20" Height="36"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource BgBrush}" IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <Border x:Name="RightTabFade" Grid.Row="0" Width="20" Height="36"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{DynamicResource BgBrush}" IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <ScrollBar x:Name="RequestTabsScrollBar" Grid.Row="1" Orientation="Horizontal"
                               Height="7" MinHeight="7" Style="{StaticResource RequestTabsScrollBarStyle}"
                               Visibility="Collapsed"
                               ValueChanged="RequestTabsScrollBar_ValueChanged"/>
                </Grid>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="RequestTabs" MinHeight="38" MinWidth="0"
                        HorizontalAlignment="Stretch" Margin="0,0,24,0"
                        Background="Transparent" BorderThickness="0"
                        ItemContainerStyle="{StaticResource RequestTabItem}"
                        Template="{StaticResource RequestTabsWithAddTemplate}"
                        SelectionChanged="RequestTabs_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="×" Click="CloseTab_Click"
                                    Style="{StaticResource RequestTabCloseButton}"
                                    ToolTip="Fermer l’onglet"
                                    AutomationProperties.Name="Fermer l’onglet"/>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SendButton" Content="Envoyer" Click="Send_Click" Margin="8,0,0,0"
                        Style="{DynamicResource AccentButtonStyle}" MinWidth="100"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MethodBox" Grid.Column="0" IsEditable="False" SelectedIndex="0"
                              VerticalContentAlignment="Center" Margin="0,0,8,0"
                              BorderBrush="{DynamicResource LineBrush}"
                              SelectionChanged="Method_SelectionChanged">
                        <ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/>
                        <ComboBoxItem Content="PUT"/><ComboBoxItem Content="PATCH"/>
                        <ComboBoxItem Content="DELETE"/><ComboBoxItem Content="HEAD"/>
                        <ComboBoxItem Content="OPTIONS"/>
                    </ComboBox>
                    <TextBox x:Name="UrlBox" Grid.Column="1" ui:ControlHelper.PlaceholderText="URL (https://…)"
                             VerticalContentAlignment="Center" BorderBrush="{DynamicResource LineBrush}"
                             KeyDown="Url_KeyDown"
                             TextChanged="RequestChanged"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Content="Annuler" Click="Cancel_Click"
                            Margin="8,0,0,0" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="WarningText" Grid.Row="1" Margin="0,8,0,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                <TabControl Grid.Row="2" Margin="0,8,0,0"
                            Style="{StaticResource RequestEditorSectionTabs}">
                    <TabItem Header="En-têtes">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Supprimer la sélection"
                                        Click="RemoveHeader_Click" Padding="10,4"/>
                                <Button Content="+ Ajouter un en-tête" Click="AddHeader_Click" Padding="10,4"
                                        HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DataGrid x:Name="HeadersGrid" Grid.Row="1" Style="{StaticResource FlatGrid}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                      RowHeaderWidth="0" MinHeight="120"
                                      CellEditEnding="HeadersGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                    <DataGridTextColumn Header="Valeur" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Margin="2,8,0,0" Text="Les en-têtes répétés sont conservés autant que le permet le protocole HTTP."
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Corps">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ContentTypeBox" ui:ControlHelper.PlaceholderText="Content-Type"
                                     Margin="0,0,0,8" TextChanged="RequestChanged"/>
                            <views:JsonTextEditor x:Name="BodyBox" Grid.Row="1"
                                                  TextChanged="BodyBox_TextChanged"
                                                  LostKeyboardFocus="BodyBox_LostKeyboardFocus"/>
                            <TextBlock Grid.Row="2" x:Name="BodyFormatHint"
                                       Text="Le formatage améliore la lisibilité; les octets capturés restent inchangés tant que vous ne modifiez pas le corps."
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <CheckBox x:Name="AllowIncompleteCheck" Grid.Row="3"
                                      Content="Autoriser explicitement l’envoi d’un corps incomplet"
                                      Visibility="Collapsed" Checked="RequestChanged" Unchecked="RequestChanged"
                                      Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Options">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <CheckBox x:Name="FollowRedirectsCheck" Content="Suivre les redirections"
                                              IsChecked="True" Margin="0,4" Checked="RequestChanged" Unchecked="RequestChanged"/>
                                    <CheckBox x:Name="IgnoreTlsCheck" Content="Ignorer les erreurs de certificat TLS (non recommandé)"
                                              Margin="0,4" Checked="RequestChanged" Unchecked="RequestChanged"/>
                                    <CheckBox x:Name="HttpFreeKitProxyCheck" Content="Passer par le proxy HTTP FreeKit"
                                              Margin="0,4" Checked="RequestChanged" Unchecked="RequestChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Width="240" HorizontalAlignment="Left"
                                            Margin="16,0,0,0">
                                    <TextBlock Text="Version HTTP" Margin="0,2,0,4"/>
                                    <ComboBox x:Name="HttpVersionBox" IsEditable="False" SelectedIndex="2"
                                              HorizontalAlignment="Stretch" SelectionChanged="RequestChanged">
                                        <ComboBoxItem Content="HTTP/1.1"/><ComboBoxItem Content="HTTP/2"/>
                                        <ComboBoxItem Content="Automatique"/>
                                    </ComboBox>
                                    <TextBlock Text="Délai maximum (secondes)" Margin="0,10,0,4"/>
                                    <TextBox x:Name="TimeoutBox" Text="60" Width="90" HorizontalAlignment="Left"
                                             TextChanged="RequestChanged"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="Les requêtes directes ignorent le proxy système. HTTP/2 ne garantit pas l’ordre exact des en-têtes."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="Transparent"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResponseSummary" Text="La réponse apparaîtra ici."
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="2,0,12,0"/>
                    <Button Grid.Column="1" Content="Enregistrer le corps…" Click="SaveResponse_Click"
                            VerticalAlignment="Center" Padding="12,5"/>
                </Grid>
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{StaticResource DetailTabItem}">
                    <TabItem Header="Corps">
                        <views:BodyPreview x:Name="ResponseBodyPreview"/>
                    </TabItem>
                    <TabItem Header="En-têtes">
                        <views:HeadersPreview x:Name="ResponseHeadersPreview"/>
                    </TabItem>
                    <TabItem Header="Redirections">
                        <TextBox x:Name="ResponseRedirectsBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" Background="{DynamicResource BgBrush}"
                                 BorderThickness="0" Padding="8"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
