<UserControl x:Class="HttpFreeKit.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Bloquer une application…" Click="Add_Click" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}"/>
            <Button Content="Débloquer la sélection" Click="Unblock_Click" Margin="0,0,20,0"/>
            <Button Content="Tout débloquer" Click="UnblockAll_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="8" Padding="0" ClipToBounds="True">
        <Grid>
        <DataGrid x:Name="FwGrid" Style="{StaticResource FlatGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Program}" Width="*"/>
                <DataGridTextColumn Header="Bloquée le" Binding="{Binding CreatedText}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No blocked applications" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Opacity="0.65" TextWrapping="Wrap"
                   Text="Chaque blocage crée deux règles du Pare-feu Windows (entrant + sortant) dans le groupe « HttpFreeKit ». Elles sont toutes supprimées par « Tout débloquer », par la désinstallation (Paramètres) ou par HTTP FreeKit.exe --cleanup."/>
    </Grid>
</UserControl>
