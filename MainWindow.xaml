<Window x:Class="HttpFreeKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:HttpFreeKit.Views"
        Title="HTTP FreeKit" Icon="Assets/app.ico"
        Width="1360" Height="820" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource AppForegroundBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="close"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource HttpFreeKitAccentLightColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource HttpFreeKitAccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M5,9 H17 M14,6 L17,9 L14,12 M19,15 H7 M10,12 L7,15 L10,18"
                              Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <TextBlock Text="HTTP FreeKit" FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForegroundBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>


                <Border Grid.Column="4" CornerRadius="18" Background="{DynamicResource Surface2Brush}"
                        Padding="10,0" Height="36" MinWidth="250" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ui:ToggleSwitch x:Name="CaptureToggle" OnContent="Capture active" OffContent="Capture arrêtée"
                                         MinWidth="230" VerticalAlignment="Center" Margin="0" Toggled="CaptureToggle_Toggled"
                                         WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Border>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 2,8 H 14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" Stretch="None"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click"
                            ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="GlyphMax" Data="M 3,3 H 13 V 13 H 3 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" Stretch="None"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Tag="close" Click="Close_Click"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Fill"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


        <ui:NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="False"
                           IsBackButtonVisible="Collapsed" OpenPaneLength="190"
                           SelectionChanged="Nav_SelectionChanged"
                           Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Trafic" Tag="traffic" IsSelected="True">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE774;"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Tests réseau" Tag="nettests">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE768;"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Règles" Tag="rules">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8FD;"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Connexions" Tag="connections">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE968;"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Pare-feu" Tag="firewall">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE72E;"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Paramètres" Tag="settings">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE713;"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid>
                <views:TrafficView x:Name="TrafficPage"/>
                <views:NetTestsView x:Name="NetTestsPage" Visibility="Collapsed"/>
                <views:RulesView x:Name="RulesPage" Visibility="Collapsed"/>
                <views:ConnectionsView x:Name="ConnectionsPage" Visibility="Collapsed"/>
                <views:FirewallView x:Name="FirewallPage" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
            </Grid>
        </ui:NavigationView>
    </Grid>
</Window>
